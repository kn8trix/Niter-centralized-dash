# Copy this file to `.env` and fill in real values.
# Real environment variables (set by your process manager / hosting platform)
# always take precedence over this file.

# --- Required ------------------------------------------------------------------
# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# REQUIRED — the app fails to start (ImproperlyConfigured) when DEBUG=False
# and SECRET_KEY is unset.
SECRET_KEY=change-me-to-a-long-random-string

# MUST be False in production. Debug mode is only safe on localhost.
DEBUG=False

# Comma-separated host/domain names the site serves.
# e.g. niter.edu.bd,www.niter.edu.bd,127.0.0.1
ALLOWED_HOSTS=niter.edu.bd,www.niter.edu.bd

# django.contrib.sites id used by django-allauth (must match the Site row the
# Google SocialApp is attached to). Defaults to 1 when unset.
SITE_ID=1

# --- Optional -------------------------------------------------------------------
# Full database URL. Unset → local SQLite (db.sqlite3).
# PostgreSQL:  postgres://USER:PASSWORD@HOST:5432/DBNAME
# MySQL:       mysql://USER:PASSWORD@HOST:3306/DBNAME
# Supabase PostgreSQL (preferred in production). ``sslmode=require`` is
# appended automatically for postgres URLs. When set, this wins over
# DATABASE_URL below; unset → DATABASE_URL → local SQLite (dev/tests).
SUPABASE_DB_URL=postgres://postgres:change-me@db.<project>.supabase.co:5432/postgres

DATABASE_URL=postgres://niter:change-me@127.0.0.1:5432/niter

# Redis URL for the real-time WebSocket channel layer (channels_redis).
# Unset OR unreachable → the app falls back to the in-memory channel layer
# (single-process dev only; use Redis in production).
REDIS_URL=redis://127.0.0.1:6379/0

# --- Google Drive / Sheets OAuth (all optional) --------------------------------
# Application credentials for the Drive connect/callback flow and club sheets.
# When GOOGLE_CLIENT_ID is set, allauth also uses these (instead of a DB
# SocialApp row). Leave unset to keep using the admin-configured SocialApp.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered as an Authorized redirect URI in the Google Cloud console.
GOOGLE_REDIRECT_URI=https://niter.edu.bd/drive/callback/

# Optional Fernet key for encrypting stored Google OAuth tokens. When unset,
# a stable key is derived from SECRET_KEY. Set an explicit value to rotate
# token encryption independently of the session secret.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Comma-separated origins allowed to POST with CSRF protection.
CSRF_TRUSTED_ORIGINS=https://niter.edu.bd,https://www.niter.edu.bd

# Security flags (applied only while DEBUG=False; all default to True/secure).
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# --- Research AI (OpenRouter) — all optional ----------------------------------
# Backend LLM provider for the Academic Research & Thesis Assistant (/research-ai/).
# When OPENROUTER_API_KEY is empty the endpoint degrades gracefully to the
# built-in offline research engine (no external calls). Create a key at
# https://openrouter.ai/keys and use any OpenRouter model slug.
#
# Zero-cost strategy: the default model is NVIDIA Nemotron 3.5 Lightning (free
# tier). When it returns 429/503 the client automatically retries once with
# OPENROUTER_FALLBACK_MODEL ('openrouter/free' auto-router).
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_FALLBACK_MODEL=openrouter/free  # constant in settings.py
# Vision model for the student dashboard routine extractor (image scans).
# OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# --- Payments (bKash / Nagad webhooks) — all optional -------------------------
# Webhook/callback handling works without any of these (callbacks are matched
# by merchant invoice id and, for Nagad, signature-verified with the built-in
# sha256 formula). The reserved variables below are only needed once the
# gateway initiation / status-verification calls are wired up.
#
# Nagad: recompute the callback signature and reject mismatches.
#   false is useful only while testing against a stub gateway.
PAYMENTS_VERIFY_SIGNATURES=True

# Public callback URLs for the server-to-server webhooks (live with the
# merchant account). Local dev uses the runserver address, e.g.
#   http://localhost:8000/payments/webhook/nagad/  (exposed via ngrok/localtunnel
#   so the gateway can reach it).
# NAGAD_CALLBACK_URL=https://niter.edu.bd/payments/webhook/nagad/
# BKASH_CALLBACK_URL=https://niter.edu.bd/payments/webhook/bkash/

# bKash merchant API credentials (reserved — for createPayment / status API).
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad merchant credentials (reserved — for check-out / verify API).
# NAGAD_MERCHANT_ID=
# NAGAD_PG_PUBLIC_KEY=
# NAGAD_PRIVATE_KEY=
# NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs

# --- Email (two-step signup verification via Gmail SMTP) ------------------------
# Used to deliver the 6-digit verification code during student signup.
# Use a Google App Password (not your normal Gmail password):
#   https://myaccount.google.com/apppasswords
# With these unset and DEBUG=True the console backend prints the email instead
# (no real sending) so local signup stays testable.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional overrides (defaults: smtp.gmail.com / 587 / TLS on)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@niterdash.com
